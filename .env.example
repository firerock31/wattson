# Wattson configuration. Copy to .env and fill in.
#   cp .env.example .env

# --- Required: home location (decimal degrees) ---
# Used to detect home charging sessions and compute home charging cost.
# Find yours: https://www.latlong.net/
RIVIAN_HOME_LAT=
RIVIAN_HOME_LON=

# --- Your home electricity rate ($/kWh, all-in) ---
# Shown as the cost on home charging sessions. Check your utility bill.
RIVIAN_HOME_KWH_RATE=0.30

# --- Optional: your timezone (IANA name) ---
# Used for dashboard dates and times.
WATTSON_TIMEZONE=America/Los_Angeles

# --- Optional: dashboard display name ---
# Defaults to your Rivian account's vehicle name, then "My Rivian".
RIVIAN_VEHICLE_NAME=
RIVIAN_VEHICLE_MODEL=

# --- Optional: fuel-savings comparison ---
# MPG of the gas SUV your EV is compared against for "savings vs gas".
WATTSON_GAS_COMPARISON_MPG=25
# Pin a gas price ($/gal) instead of scraping AAA. Useful for demo mode,
# offline use, or regions AAA doesn't cover.
#WATTSON_GAS_PRICE=
# AAA gas-price source (page URL + metro label). Change the state/metro
# for your area; the defaults cover the Los Angeles metro.
WATTSON_GAS_PRICE_URL=https://gasprices.aaa.com?state=CA
WATTSON_GAS_PRICE_METRO=Los Angeles-Long Beach
